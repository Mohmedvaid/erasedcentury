# YouTube Data API v3 key
# Get one at: https://console.cloud.google.com/apis/credentials
# Enable "YouTube Data API v3" in your project first
YOUTUBE_API_KEY=your_api_key_here

# Your YouTube Channel ID (not the @handle)
# Find it: Go to your channel → View Page Source → search for "channelId"
# Or use: https://www.youtube.com/@ErasedCentury → About → Share → Copy Channel ID
YOUTUBE_CHANNEL_ID=your_channel_id_here
